# --- Required to boot the server (Milestone 1) ---
PORT=4000
DATABASE_URL="postgresql://thrifty:thrifty@localhost:5432/thrifty"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
DEFAULT_RETURN_WINDOW_DAYS=30
DEFAULT_WARRANTY_WINDOW_DAYS=365

# --- Milestone 2: Warranty Wallet receipt extraction + push notifications ---
# Required for POST /receipts to work — without it, receipt scanning fails with a clear error.
# ANTHROPIC_API_KEY=
# Optional: only needed for Expo's enhanced push-security features, not for sending pushes.
# EXPO_ACCESS_TOKEN=

# --- Milestone 3: SubStop bank-data provider (India Account Aggregator) ---
# Required (any random string) before any bank account can be linked — encrypts stored access
# tokens at rest. Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=
# Real consent/session-flow code and RBI-mandated ECDH+AES-GCM FI-data decryption are implemented
# (see src/modules/bank/accountAggregator/), but a signed FIU agreement with an AA/TSP partner
# (e.g. Setu) is still required to get real credentials and confirm exact endpoint paths — until
# then this stays a clean 503.
# SETU_AA_CLIENT_ID=
# SETU_AA_CLIENT_SECRET=
# SETU_AA_PRODUCT_INSTANCE_ID=
# SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
# Shared secret Setu sends back on every Consent-Notification/Data-Notification webhook call
# (Authorization: Bearer <this>) — confirm the actual scheme in their partner docs; this is a
# reasonable placeholder auth check, not verified against a live Setu webhook.
# SETU_AA_WEBHOOK_SECRET=

# --- Milestone 4: cancellation-request emails ---
# Required for POST /cancellation-requests/:id/send to work. Get a token at
# https://postmarkapp.com/ (free tier available) and verify a sending domain/address there first.
# POSTMARK_SERVER_TOKEN=
# Must be a sender address verified in your Postmark account.
# CANCELLATION_FROM_EMAIL=
# Note: the KnownService seed data (prisma/seed.ts) intentionally ships with zero email-method
# entries — only verified real cancellation contacts should be added there. Most seeded services
# use the safe `self_service_url` method (deep-links to the provider's real account page) instead.

# --- Milestone 5: billing (Premium upgrade) ---
# Required for POST /billing/checkout to work. Create a Plan in your Razorpay dashboard first and
# put its ID in RAZORPAY_PLAN_ID.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_ID=
# Required for POST /billing/webhook/razorpay to process events.
# RAZORPAY_WEBHOOK_SECRET=

# --- Milestone 6: inbound email (receipt forwarding) ---
# The domain shown to users as their forwarding address (e.g. "abc123@INBOUND_EMAIL_DOMAIN").
# Set up Postmark's inbound-parse for this domain pointing at
# POST /inbound-email/webhook/POSTMARK_INBOUND_SIGNATURE_SECRET.
# INBOUND_EMAIL_DOMAIN=inbound.example.com
# A hard-to-guess secret used as a URL path segment — Postmark doesn't sign inbound webhook
# payloads with an HMAC the way it does outbound ones, so this is the auth mechanism instead.
# Generate with: openssl rand -hex 24
# POSTMARK_INBOUND_SIGNATURE_SECRET=

# --- Roadmap expansion, Milestone 1: phone-OTP + Google/Apple sign-in ---
# Required for POST /auth/otp/send to work. Get these from https://console.twilio.com/.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Required for POST /auth/google. Create an OAuth 2.0 Client ID (Web application type is fine
# even for mobile, since this only verifies the ID token's audience) at
# https://console.cloud.google.com/apis/credentials — must match the mobile app's
# EXPO_PUBLIC_GOOGLE_*_CLIENT_ID (apps/mobile/.env.example).
# GOOGLE_CLIENT_ID=
# Required for POST /auth/apple. This is your app's bundle identifier / Services ID from
# https://developer.apple.com/account/resources/identifiers/list.
# APPLE_CLIENT_ID=

# --- Roadmap expansion, Milestone 1: file storage (S3/R2) ---
# Optional — defaults to local disk. Set STORAGE_PROVIDER=s3 plus these to use AWS S3 or any
# S3-compatible host (Cloudflare R2, etc; set S3_ENDPOINT + S3_FORCE_PATH_STYLE=true for R2).
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- Roadmap expansion, Milestone 2: email integration ---
# Required for POST /email-connections/authorize {provider: "gmail"} to work. Create an OAuth 2.0
# Web application Client ID at https://console.cloud.google.com/apis/credentials with the Gmail
# API enabled and gmail.readonly scope; add ${SERVER_PUBLIC_URL}/email-connections/callback/gmail
# as an authorized redirect URI. Distinct from GOOGLE_CLIENT_ID above (that one's for sign-in only
# and doesn't need Gmail scopes). Beyond 100 test users, Google requires a CASA security
# assessment for production access to gmail.readonly — pursue that separately; the code works
# against your own test users regardless.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Required for POST /email-connections/authorize {provider: "outlook"} to work. Register an app at
# https://entra.microsoft.com/ (Azure AD app registrations) with Mail.Read + offline_access
# delegated permissions; add ${SERVER_PUBLIC_URL}/email-connections/callback/outlook as a
# redirect URI (platform: Web).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Required for POST /email-connections/authorize {provider: "yahoo"} to work. Register an app at
# https://developer.yahoo.com/apps/. Note: this only verifies which Yahoo address the user owns —
# Yahoo doesn't offer a public Mail-read API for new developers, so Yahoo connections can't
# actually scan for receipts (see src/modules/email/yahooProvider.ts).
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# The server's own publicly-reachable base URL, used to build the OAuth redirect_uri sent to
# Google/Microsoft/Yahoo (they redirect the user's browser back to this server after consent,
# which then redirects into the app via the thrifty:// custom scheme). Must be HTTPS in
# production. Defaults to http://localhost:PORT for local testing (won't satisfy providers that
# require HTTPS, but lets the code path run against a tunnel like ngrok).
# SERVER_PUBLIC_URL=http://localhost:4000

# --- Roadmap expansion, Milestone 3: WhatsApp integration ---
# Required for sending WhatsApp replies (POST /webhooks/whatsapp processing) and receiving them at
# all. Create a Meta developer app with the WhatsApp product at https://developers.facebook.com/,
# get a WABA (WhatsApp Business Account) verified, and register a phone number.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Shown to users in the "Link WhatsApp" screen as the number to text their code to.
# WHATSAPP_DISPLAY_PHONE_NUMBER=
# Required to verify inbound webhook signatures (X-Hub-Signature-256) — this is your Meta app's
# secret, found in the app dashboard under Settings > Basic.
# WHATSAPP_APP_SECRET=
# Any string you choose — set the same value when registering the webhook URL in the Meta App
# Dashboard's WhatsApp > Configuration screen; used for Meta's one-time GET verification handshake.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Roadmap expansion, Milestone 1: background jobs + observability ---
# Optional — background jobs (email polling in a later milestone) are inert without this.
# REDIS_URL=redis://127.0.0.1:6379
# Optional crash reporting / product analytics — both inert until set.
# SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
