generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Country {
  US
  IN
}

enum Tier {
  free
  premium
}

enum WarrantyItemStatus {
  active
  return_expiring
  warranty_expiring
  expired
}

enum AuthProvider {
  password
  phone
  google
  apple
}

model User {
  id                      String       @id @default(uuid())
  email                   String?      @unique
  phoneNumber             String?      @unique
  passwordHash            String?
  authProvider            AuthProvider @default(password)
  country                 Country
  tier                    Tier         @default(free)
  pushToken               String?
  billingCustomerId       String?
  billingSubscriptionId   String?
  inboundEmailToken       String       @unique @default(uuid())
  householdId             String?
  household               Household?   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  notificationPreferences Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  warrantyItems         WarrantyItem[]
  linkedBankAccounts    LinkedBankAccount[]
  detectedSubscriptions DetectedSubscription[]
  pendingBankLinks      PendingBankLink[]
  cancellationRequests  CancellationRequest[]
  notifications         Notification[]
  emailConnections      EmailConnection[]
  pendingEmailOAuths    PendingEmailOAuth[]
  whatsAppLinkCodes     WhatsAppLinkCode[]
  whatsAppConnection    WhatsAppConnection?
  bankConsents          BankConsent[]
  claims                     Claim[]
  cancellationSavingsCharges CancellationSavingsCharge[]
  householdMemberships       HouseholdMember[]
}

model Household {
  id         String   @id @default(uuid())
  name       String
  createdBy  String
  inviteCode String?  @unique
  createdAt  DateTime @default(now())

  users   User[]
  members HouseholdMember[]
}

enum HouseholdRole {
  owner
  member
}

model HouseholdMember {
  id          String        @id @default(uuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(member)
  createdAt   DateTime      @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

// Short-lived one-time codes for phone auth. Not linked to User by FK since the user may not
// exist yet at send-time (signup) — verification creates/finds the User by phone afterward.
model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}

enum NotificationType {
  return_window
  warranty_expiry
  subscription_renewal
  unused_subscription
}

enum NotificationStatus {
  pending
  sent
  dismissed
  actioned
}

model Notification {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedWarrantyItemId String?
  relatedSubscriptionId String?
  type                  NotificationType
  scheduledFor          DateTime
  sentAt                DateTime?
  status                NotificationStatus  @default(pending)
  createdAt             DateTime            @default(now())

  @@index([userId])
}

// Per-retailer override for return-window / warranty-window length in days.
// Falls back to DEFAULT_RETURN_WINDOW_DAYS / DEFAULT_WARRANTY_WINDOW_DAYS (see src/config/env.ts)
// when no row matches the retailer name.
model RetailerRule {
  id                 String @id @default(uuid())
  retailerName       String @unique
  returnWindowDays   Int
  warrantyWindowDays Int
}

model WarrantyItem {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemName          String
  retailer          String?
  purchaseDate      DateTime
  price             Float?
  currency          String?
  sourceImageUrl    String?
  returnWindowEndsAt   DateTime?
  warrantyEndsAt       DateTime?
  notifiedReturn       Boolean  @default(false)
  notifiedWarranty     Boolean  @default(false)
  status            WarrantyItemStatus @default(active)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  claims Claim[]

  @@index([userId])
}

enum BankProvider {
  plaid
  account_aggregator
}

enum SubscriptionCadence {
  weekly
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  flagged
  cancelled
}

// A link session the user has started but not yet completed (hosted-link flow) — lets the
// webhook/poll handler map a Plaid link_token back to the Thrifty user who started it.
model PendingBankLink {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  BankProvider
  linkToken String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model LinkedBankAccount {
  id                   String       @id @default(uuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             BankProvider
  providerItemId       String       @unique
  encryptedAccessToken String
  institutionName      String?
  lastSyncedAt         DateTime?
  createdAt            DateTime     @default(now())

  // Account Aggregator-specific: which FI-data session produced this account, which FIP
  // (Financial Information Provider — the user's actual bank) it came from, and the consent
  // that authorized it. Null for Plaid-linked (US) accounts.
  aaSessionId   String?
  fipId         String?
  bankConsentId String?
  bankConsent   BankConsent? @relation(fields: [bankConsentId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId])
}

enum ConsentStatus {
  pending
  active
  paused
  rejected
  revoked
  expired
}

// Tracks the lifecycle of one RBI-mandated Account Aggregator consent request, from creation
// through the user's approval (or rejection) in the AA's own consent-approval UI, through to
// expiry. `consentHandle` is assigned by us when the request is created and is what the AA's
// consent-notification webhook echoes back so we can find this row; `consentId` is assigned by
// the AA only once the user actually approves, and is what's used for every subsequent FI-data
// session request.
model BankConsent {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentHandle String        @unique
  consentId     String?       @unique
  status        ConsentStatus @default(pending)
  purposeCode   String
  fetchType     String
  consentExpiry DateTime?
  fipIds        String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  linkedAccounts LinkedBankAccount[]

  @@index([userId])
}

model Transaction {
  id                    String            @id @default(uuid())
  linkedAccountId       String
  linkedAccount         LinkedBankAccount @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  providerTransactionId String            @unique
  merchantRaw           String
  merchantNormalized    String
  amount                Float
  currency              String
  date                  DateTime
  createdAt             DateTime          @default(now())

  @@index([linkedAccountId])
  @@index([merchantNormalized])
}

model DetectedSubscription {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantNormalized String
  displayName        String
  avgAmount          Float
  currency           String
  cadence            SubscriptionCadence
  firstSeen          DateTime
  lastSeen           DateTime
  status             SubscriptionStatus  @default(active)
  userConfirmedInUse Boolean?
  detectedFromBank   Boolean             @default(true)
  detectedFromEmail  Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, merchantNormalized])
  @@index([userId])

  cancellationRequests CancellationRequest[]
  savingsCharges       CancellationSavingsCharge[]
}

enum CancellationMethod {
  self_service_url
  email
}

enum CancellationRequestStatus {
  draft
  sent
  failed
}

// A curated directory mapping a normalized merchant name to how it's actually cancelled.
// `self_service_url` is the default/safe method (just deep-links to the provider's real account
// page). `email` entries are only ever added once a cancellation contact has been verified — see
// prisma/seed.ts for why the seed data intentionally ships with zero `email` rows.
model KnownService {
  id                String             @id @default(uuid())
  merchantPattern   String             @unique
  displayName       String
  method            CancellationMethod
  selfServiceUrl    String?
  cancellationEmail String?
  instructions      String
}

model CancellationRequest {
  id                     String                    @id @default(uuid())
  userId                 String
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedSubscriptionId String
  detectedSubscription   DetectedSubscription      @relation(fields: [detectedSubscriptionId], references: [id], onDelete: Cascade)
  method                 CancellationMethod
  recipientEmail         String?
  draftSubject           String?
  draftBody              String?
  status                 CancellationRequestStatus @default(draft)
  sentAt                 DateTime?
  createdAt              DateTime                  @default(now())

  @@index([userId])
}

enum EmailProvider {
  gmail
  outlook
  yahoo
}

enum EmailSyncStatus {
  pending
  active
  error
  disconnected
}

// Tracks an in-flight OAuth authorization (authorize -> provider consent screen -> callback).
// The `state` query param sent to the provider is this row's id, so the callback can recover
// which user/provider started the flow without trusting anything the provider redirect sends
// back beyond that id. Mirrors PendingBankLink's role for Plaid's hosted-link flow.
model PendingEmailOAuth {
  id                      String        @id @default(uuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                EmailProvider
  historicalScanDepthDays Int           @default(30)
  createdAt               DateTime      @default(now())

  @@index([userId])
}

model EmailConnection {
  id                      String          @id @default(uuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                EmailProvider
  emailAddress            String
  encryptedAccessToken    String
  encryptedRefreshToken   String?
  tokenExpiresAt          DateTime?
  scope                   String?
  historicalScanDepthDays Int             @default(30)
  syncStatus              EmailSyncStatus @default(pending)
  syncError               String?
  lastSyncToken           String?
  lastSyncedAt            DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  scannedMessages ScannedEmailMessage[]

  @@unique([userId, provider, emailAddress])
  @@index([userId])
}

enum ScannedEmailStatus {
  saved
  pending_review
  duplicate
  ignored
}

// One row per email message we've looked at, keyed so a re-poll of the same provider message
// never gets processed twice (@@unique below). Also doubles as storage for the review-before-save
// queue: a `pending_review` row holds the low-trust Claude-extracted fields until the user
// approves or rejects them in the mobile app.
model ScannedEmailMessage {
  id                    String             @id @default(uuid())
  emailConnectionId     String
  emailConnection       EmailConnection    @relation(fields: [emailConnectionId], references: [id], onDelete: Cascade)
  providerMessageId     String
  fromAddress           String
  subject               String
  orderIdentifier       String?
  status                ScannedEmailStatus
  extractedItemName     String?
  extractedRetailer     String?
  extractedPurchaseDate DateTime?
  extractedPrice        Float?
  extractedCurrency     String?
  rawTextSnippet        String?
  createdWarrantyItemId String?
  duplicateOfMessageId  String?
  createdAt             DateTime           @default(now())

  @@unique([emailConnectionId, providerMessageId])
  @@index([orderIdentifier])
}

// A short-lived code the user is shown in-app and texts to Thrifty's WhatsApp Business number to
// prove they own that WhatsApp-linked phone number — the same "prove ownership via an
// out-of-band channel" idea as phone-OTP, just over WhatsApp instead of SMS.
model WhatsAppLinkCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model WhatsAppConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String   @unique
  linkedAt    DateTime @default(now())
}

enum ClaimType {
  warranty_defect
  return_assistance
}

enum ClaimStatus {
  draft
  submitted
  resolved
}

// A curated directory mapping a normalized merchant name to a real, verified service-center
// contact (phone/email/URL) for filing a warranty claim — same honest pattern as KnownService:
// ships with zero real contacts, since a wrong phone number/email for something as consequential
// as a warranty claim is worse than no directory entry at all. Add rows only once verified.
model ServiceCenterContact {
  id              String  @id @default(uuid())
  merchantPattern String  @unique
  displayName     String
  contactMethod   String
  contactValue    String
  instructions    String

  claims Claim[]
}

// Unifies warranty-defect claims and "help me get this return processed" requests under one
// user-facing "Claims" list — separate from CancellationRequest (subscriptions) and the
// return/warranty countdown itself (WarrantyItem), which already have their own flows.
model Claim {
  id                     String                @id @default(uuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  warrantyItemId         String
  warrantyItem           WarrantyItem          @relation(fields: [warrantyItemId], references: [id], onDelete: Cascade)
  type                   ClaimType
  status                 ClaimStatus           @default(draft)
  description            String?
  serviceCenterContactId String?
  serviceCenterContact   ServiceCenterContact? @relation(fields: [serviceCenterContactId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId])
}

enum ChargeProvider {
  stripe
  razorpay
}

enum ChargeStatus {
  pending
  charged
  failed
}

// Revenue-share pricing: instead of (or alongside) flat Premium, a user can pay only when
// Thrifty actually helps them cancel something and save money — a percentage of the first
// year's savings, charged as a one-time payment once they confirm the cancellation worked.
model CancellationSavingsCharge {
  id                     String               @id @default(uuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedSubscriptionId String
  detectedSubscription   DetectedSubscription @relation(fields: [detectedSubscriptionId], references: [id], onDelete: Cascade)
  estimatedAnnualSavings Float
  chargeAmount           Float
  currency               String
  status                 ChargeStatus         @default(pending)
  provider               ChargeProvider?
  providerChargeId       String?
  createdAt              DateTime             @default(now())

  @@index([userId])
}
