# Optional — Expo automatically inlines any EXPO_PUBLIC_* var into the client bundle.
# Copy this to .env and fill in values as you configure each integration; the app runs fine
# without any of them (Google/Apple buttons just won't complete, and Sentry/PostHog stay off).

# Google Sign-In (see apps/server/.env.example GOOGLE_CLIENT_ID — must match the Google Cloud
# OAuth client(s) you create there). At least one of these three is needed depending on platform.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sentry crash reporting
# EXPO_PUBLIC_SENTRY_DSN=

# PostHog product analytics
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
