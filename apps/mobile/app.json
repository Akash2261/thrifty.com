{
  "expo": {
    "name": "Thrifty",
    "slug": "thrifty",
    "scheme": "thrifty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.one10.thrifty",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Thrifty uses your camera to scan receipts and extract warranty/return information.",
        "NSPhotoLibraryUsageDescription": "Thrifty needs access to your photos so you can pick an existing receipt image to scan."
      }
    },
    "android": {
      "package": "com.One10.thrifty",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Thrifty needs access to your photos so you can pick an existing receipt image to scan.",
          "cameraPermission": "Thrifty uses your camera to scan receipts and extract warranty/return information."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-web-browser",
      "@sentry/react-native/expo",
      "expo-apple-authentication",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "router": {},
      "eas": {
        "projectId": "c04269ff-0fb0-4ae6-a377-4385f207d398"
      }
    },
    "owner": "at5314"
  }
}
